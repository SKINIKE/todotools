{
  "name": "electron-todotools",
  "version": "1.0.0",
  "description": "Desktop TodoTools Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "watch": "webpack --watch",
    "dev": "webpack && electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "webpack --mode production && electron-builder"
  },
  "keywords": [
    "todo",
    "productivity",
    "electron",
    "desktop"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3",
    "style-loader": "^3.3.4",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.7",
    "electron-store": "^8.1.0"
  },
  "build": {
    "appId": "com.todotools.app",
    "productName": "TodoTools",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
} 